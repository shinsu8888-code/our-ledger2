rules_version = '2';

// 우리집 가계부 보안 규칙 — Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // invites/{초대코드} : 초대코드 -> 가계부 id 매핑
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // households/{hid} : 가계부 본체
    match /households/{hid} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // 멤버가 아닌 사용자가 "자기 자신을 멤버로 추가하는" 초대코드 참여 요청만 허용
      function isSelfJoin() {
        return signedIn()
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberProfiles']);
      }

      allow get, list: if isMember();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isMember() || isSelfJoin();
      allow delete: if false;

      // households/{hid}/transactions : 거래 내역
      match /transactions/{tid} {
        function householdMembers() {
          return get(/databases/$(database)/documents/households/$(hid)).data.members;
        }

        allow read: if signedIn() && request.auth.uid in householdMembers();

        // 거래 등록: ownerUid가 반드시 자기 자신이어야 함
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.auth.uid in householdMembers();

        // 수정/삭제: 등록한 본인만 가능
        allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
